{
  "name": "arc-invoice-receipts",
  "version": "0.1.0",
  "description": "Pay-by-link USDC invoices with on-chain receipts for Arc. Non-upgradeable, ownerless, fee-free. Static web app, no server.",
  "license": "MIT",
  "private": false,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:arc-anvil": "hardhat test test/InvoiceReceipts.test.js --network arcAnvil",
    "coverage": "hardhat coverage --testfiles test/InvoiceReceipts.test.js",
    "deploy:testnet": "hardhat run scripts/deploy.js --network arcTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network arcMainnet",
    "scenario:testnet": "hardhat run scripts/scenario.js --network arcTestnet",
    "scenario:mainnet": "hardhat run scripts/scenario.js --network arcMainnet",
    "web:config": "node scripts/write-web-config.js",
    "check:testnet": "hardhat run scripts/check-deployment.js --network arcTestnet",
    "check:mainnet": "hardhat run scripts/check-deployment.js --network arcMainnet",
    "verify:testnet": "hardhat run scripts/verify.js --network arcTestnet",
    "verify:mainnet": "hardhat run scripts/verify.js --network arcMainnet",
    "verify:json": "hardhat run scripts/export-standard-json.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "qrcode-generator": "^2.0.4",
    "solidity-coverage": "^0.8.17"
  }
}
