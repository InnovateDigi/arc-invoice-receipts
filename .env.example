# Copy to .env if you like; nothing here is required to run the tests.
# Never commit a real key. Prefer DEPLOYER_KEY_FILE pointing outside the repository.

# One of these is needed to deploy (see scripts/lib/key.js):
#PRIVATE_KEY=0x...
#DEPLOYER_KEY_FILE=/absolute/path/to/key-file.json

# Optional RPC overrides
#ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
#ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
